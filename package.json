{
  "name": "@gitmetrics/app",
  "version": "1.3.0",
  "description": "A beautiful, zero-config dashboard for your GitHub repositories. Stars, traffic, commits, pull requests, Actions and more, running locally on your machine.",
  "type": "module",
  "bin": {
    "gitmetrics": "dist/cli.js"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/cli.ts --dev --no-open",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server && node scripts/third-party-licenses.mjs",
    "build:web": "vite build",
    "build:server": "esbuild src/server/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cli.js --legal-comments=none --metafile=dist/.meta-server.json",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "site:dev": "vite --config site/vite.config.ts",
    "site:build": "vite build --config site/vite.config.ts",
    "site:preview": "vite preview --config site/vite.config.ts",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "github",
    "dashboard",
    "analytics",
    "metrics",
    "stars",
    "traffic",
    "github-actions",
    "repository",
    "insights",
    "cli"
  ],
  "author": "Jean Loui Bernard Silva de Jesus",
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-only",
  "homepage": "https://gitmetrics.pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeanExtreme002/GitMetrics.git"
  },
  "bugs": {
    "url": "https://github.com/JeanExtreme002/GitMetrics/issues"
  },
  "funding": "https://github.com/sponsors/JeanExtreme002",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@mantine/charts": "^9.8.2",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@mantine/notifications": "^9.8.2",
    "@mantine/spotlight": "^9.8.2",
    "@primer/octicons-react": "^19.42.0",
    "@tabler/icons-react": "^3.52.0",
    "@tanstack/react-query": "^5.108.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "hono": "^4.13.19",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "recharts": "^3.11.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
